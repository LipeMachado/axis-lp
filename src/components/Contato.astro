---
import { ArrowUpRight, Check, Copy } from "@lucide/astro";
import Button from "./Button.astro";

const temas = [
  ["sites", "Site ou plataforma"],
  ["sistemas", "Sistema sob medida"],
  ["integracoes", "Integração ou automação"],
  ["auditoria", "Auditoria técnica"],
  ["suporte", "Suporte"],
  ["infra", "Infraestrutura"],
  ["outro", "Outro assunto"],
];

const depois = [
  "Você revisa a mensagem antes de enviar.",
  "Escopo, faixa e prazo vêm na proposta.",
  "Sem compromisso e sem pressão.",
];
---

<section id="contato" class="section section-night scroll-mt-nav">
  <div class="shell">
    <div class="grid-page items-start gap-y-12">
      <div class="col-span-4 md:col-span-6 lg:col-span-5"-item>
        <div>
        <h2 class="head">Converse sobre o projeto</h2>
        <p class="mt-5 max-w-[32ch] text-lead text-night-ink/90">
          Descreva o problema. A primeira conversa é sem custo e trata da sua operação.
        </p>

        <div class="mt-10">
          <p class="font-heading text-body font-semibold">O que acontece depois</p>
          <ul class="mt-4 grid gap-3">
            {depois.map((item) => (
              <li class="flex items-start gap-3 text-body leading-snug text-night-ink/85">
                <span class="mt-2 size-2 shrink-0 bg-brand" aria-hidden="true"></span>
                {item}
              </li>
            ))}
          </ul>
        </div>

        </div>
        <p class="mt-8 max-w-[38ch] text-body leading-snug text-night-muted">
          Não vendemos mídia, conteúdo nem redes sociais. Cuidamos da parte técnica.
        </p>
      </div>

      <div class="col-span-4 md:col-span-6 lg:col-span-6 lg:col-start-7"-item>
        <div class="bg-surface p-5 text-ink sm:p-7" data-form-shell>
          <div class="flex flex-wrap items-start justify-between gap-4">
            <div>
              <p class="font-heading text-lead font-semibold leading-none">Descreva o problema</p>
              <p class="mt-2 max-w-[42ch] text-small leading-snug text-muted">
                Canal provisório: validamos os campos aqui e preparamos o texto. Nenhum dado é enviado por esta página.
              </p>
            </div>
            <span class="status shrink-0 text-brand-strong">Canal provisório</span>
          </div>

          <form class="mt-7 grid gap-5" data-contact-form novalidate>
            <div class="grid gap-5 sm:grid-cols-2">
              <div>
                <label for="nome" class="mb-2 block text-small font-bold">Nome</label>
                <input
                  id="nome"
                  name="nome"
                  type="text"
                  autocomplete="name"
                  class="field"
                  placeholder="Seu nome"
                  aria-describedby="nome-erro"
                  required
                />
                <p id="nome-erro" class="mt-1.5 hidden text-small font-semibold text-danger-strong" data-erro="nome"></p>
              </div>
              <div>
                <label for="empresa" class="mb-2 block text-small font-bold">Empresa (opcional)</label>
                <input
                  id="empresa"
                  name="empresa"
                  type="text"
                  autocomplete="organization"
                  class="field"
                  placeholder="Nome da empresa"
                />
              </div>
            </div>

            <div class="grid gap-5 sm:grid-cols-2">
              <div>
                <label for="email" class="mb-2 block text-small font-bold">E-mail</label>
                <input
                  id="email"
                  name="email"
                  type="email"
                  autocomplete="email"
                  inputmode="email"
                  class="field"
                  placeholder="voce@empresa.com.br"
                  aria-describedby="email-erro"
                  required
                />
                <p id="email-erro" class="mt-1.5 hidden text-small font-semibold text-danger-strong" data-erro="email"></p>
              </div>
              <div>
                <label for="tema" class="mb-2 block text-small font-bold">Tema</label>
                <select id="tema" name="tema" class="field" aria-describedby="tema-erro" required>
                  <option value="">Selecione</option>
                  {temas.map(([value, label]) => (
                    <option value={value}>{label}</option>
                  ))}
                </select>
                <p id="tema-erro" class="mt-1.5 hidden text-small font-semibold text-danger-strong" data-erro="tema"></p>
              </div>
            </div>

            <div>
              <label for="mensagem" class="mb-2 block text-small font-bold">Mensagem</label>
              <textarea
                id="mensagem"
                name="mensagem"
                class="field"
                placeholder="O que trava a sua operação hoje?"
                minlength="10"
                aria-describedby="mensagem-erro"
                required
              ></textarea>
              <p id="mensagem-erro" class="mt-1.5 hidden text-small font-semibold text-danger-strong" data-erro="mensagem"></p>
            </div>

            <div class="flex flex-col gap-3 pt-2 sm:flex-row sm:items-center sm:justify-between">
              <p class="max-w-[34ch] text-small leading-snug text-muted">
                Usamos estes dados só para preparar a mensagem. Sem repasse, sem lista.
              </p>
              <Button type="submit" variant="primary" label="Descrever o problema" class="w-full sm:w-auto" disabled />
            </div>
          </form>

          <div class="hidden" data-form-success aria-live="polite">
            <div class="flex items-start gap-3 border-s-4 border-success bg-surface-2 px-4 py-3">
              <span class="mt-0.5 grid size-7 shrink-0 place-items-center bg-success text-brand-ink">
                <Check size={16} stroke-width={2.2} aria-hidden="true" />
              </span>
              <div>
                <p class="font-heading text-body font-semibold leading-tight" tabindex="-1" data-success-title>Mensagem pronta para envio</p>
                <p class="mt-1 text-small leading-snug text-muted">
                  Copie o texto e guarde até o canal de envio existir.
                </p>
              </div>
            </div>

            <div class="mt-5 bg-surface-2 p-4">
              <p class="whitespace-pre-wrap break-words text-body leading-relaxed" data-message-preview></p>
            </div>

            <div class="mt-5 flex flex-wrap items-center gap-3">
              <button
                type="button"
                data-copy-message
                class="inline-flex min-h-11 items-center gap-2 bg-ink px-4 py-2.5 text-small font-bold text-paper transition-colors hover:bg-brand hover:text-brand-ink"
              >
                <Copy size={17} stroke-width={1.7} />
                Copiar mensagem
              </button>
              <button
                type="button"
                data-reset-form
                class="inline-flex min-h-11 items-center gap-2 border border-line-strong px-4 py-2.5 text-small font-bold transition-colors hover:border-ink"
              >
                Preparar outra mensagem
                <ArrowUpRight size={16} stroke-width={1.7} />
              </button>
            </div>
            <p class="mt-4 hidden text-small font-semibold text-success-ink" data-copy-status aria-live="polite">Mensagem copiada.</p>
          </div>
        </div>

        <noscript>
          <p class="mt-4 max-w-[48ch] text-small leading-snug text-night-muted">
            O formulário precisa de JavaScript para preparar a mensagem. Nenhum dado é enviado sem a sua ação.
          </p>
        </noscript>
      </div>
    </div>
  </div>
</section>

<script>
  import { animate } from "motion";

  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const form = document.querySelector<HTMLFormElement>("[data-contact-form]");
  const success = document.querySelector<HTMLElement>("[data-form-success]");

  const setError = (name: string, message: string) => {
    const error = form?.querySelector<HTMLElement>(`[data-erro="${name}"]`);
    const field = form?.querySelector<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>(`[name="${name}"]`);
    if (error) {
      error.textContent = message;
      error.classList.toggle("hidden", !message);
    }
    if (field) {
      field.setAttribute("aria-invalid", String(Boolean(message)));
      if (message) field.style.borderColor = "var(--color-danger-strong)";
      else field.style.borderColor = "";
    }
  };

  const clearErrors = () => {
    for (const name of ["nome", "email", "tema", "mensagem"]) setError(name, "");
  };

  if (form && success) {
    const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (submit) submit.disabled = false;

    form.addEventListener("submit", (event) => {
      event.preventDefault();
      clearErrors();

      const data = new FormData(form);
      const nome = String(data.get("nome") ?? "").trim();
      const email = String(data.get("email") ?? "").trim();
      const tema = String(data.get("tema") ?? "").trim();
      const mensagem = String(data.get("mensagem") ?? "").trim();
      let firstInvalid: HTMLElement | null = null;

      if (nome.length < 2) {
        setError("nome", "Informe seu nome.");
        firstInvalid = form.querySelector('[name="nome"]');
      }
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        setError("email", "Informe um e-mail válido.");
        firstInvalid ??= form.querySelector('[name="email"]');
      }
      if (!tema) {
        setError("tema", "Escolha um tema.");
        firstInvalid ??= form.querySelector('[name="tema"]');
      }
      if (mensagem.length < 10) {
        setError("mensagem", "Descreva o problema com pelo menos 10 caracteres.");
        firstInvalid ??= form.querySelector('[name="mensagem"]');
      }

      if (firstInvalid) {
        firstInvalid.focus();
        return;
      }

      const temaLabel =
        form.querySelector<HTMLSelectElement>('[name="tema"]')?.selectedOptions[0]?.textContent ?? tema;
      const texto = [
        `Nome: ${nome}`,
        data.get("empresa") ? `Empresa: ${String(data.get("empresa")).trim()}` : null,
        `E-mail: ${email}`,
        `Tema: ${temaLabel}`,
        "",
        mensagem,
      ]
        .filter(Boolean)
        .join("\n");

      const preview = success.querySelector<HTMLElement>("[data-message-preview]");
      if (preview) preview.textContent = texto;

      form.classList.add("hidden");
      success.classList.remove("hidden");
      if (!reduce) {
        animate(success, { opacity: [0, 1], y: [10, 0] }, { duration: 0.4, ease: [0.22, 1, 0.36, 1] });
      }
      success.querySelector<HTMLElement>("[data-success-title]")?.focus();
      success.scrollIntoView({ behavior: reduce ? "auto" : "smooth", block: "center" });

      const copy = success.querySelector<HTMLButtonElement>("[data-copy-message]");
      const status = success.querySelector<HTMLElement>("[data-copy-status]");
      copy?.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(texto);
          status?.classList.remove("hidden");
          window.setTimeout(() => status?.classList.add("hidden"), 2600);
        } catch {
          const range = document.createRange();
          const node = preview;
          if (node) {
            range.selectNodeContents(node);
            const selection = window.getSelection();
            selection?.removeAllRanges();
            selection?.addRange(range);
          }
        }
      });
    });

    success.querySelector("[data-reset-form]")?.addEventListener("click", () => {
      success.classList.add("hidden");
      form.classList.remove("hidden");
      form.reset();
      clearErrors();
      form.querySelector<HTMLElement>('[name="nome"]')?.focus();
    });
  }

  window.addEventListener("axis:select-service", ((event: CustomEvent<{ id: string }>) => {
    const select = document.querySelector<HTMLSelectElement>('[name="tema"]');
    if (!select) return;
    const value = event.detail.id === "infra" ? "infra" : event.detail.id;
    if ([...select.options].some((option) => option.value === value)) {
      select.value = value;
    }
  }) as EventListener);
</script>
